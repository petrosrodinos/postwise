// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AuthRole {
  USER
  ADMIN
  SUPER_ADMIN
  SUPPORT
}

enum DocumentType {
  LOGO
  BANNER
  IMAGE
  VIDEO
  AUDIO
  PDF
  DOCUMENT
  OTHER
}

// Also reused as the "platform" for StyleProfile and Project — all three
// concepts (a post, the profile it's trained from, the project it's planned
// under) share the same LinkedIn/X/Blog platform space.
enum PostType {
  TWITTER
  LINKEDIN
  BLOG
}

enum PostStatus {
  DRAFT
  REVIEW
  READY
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
}

enum SocialChannel {
  TWITTER
  LINKEDIN
}

enum SocialChannelConnectionStatus {
  CONNECTED
  DISCONNECTED
  EXPIRED
  ERROR
}

enum PostChannelStatus {
  PENDING
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
}

enum OrganisationRole {
  OWNER
  ADMIN
  MEMBER
}

enum AutomationFrequency {
  DAILY
  WEEKDAYS
  WEEKLY
}

enum AutomationOutputStage {
  DRAFT
  REVIEW
  PUBLISH
}

model User {
  id       String  @id @default(uuid())
  name     String
  email    String  @unique
  phone    String? @unique
  password String

  role       AuthRole
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  password_reset_tokens    PasswordResetToken[]
  organisations_created    Organisation[]
  organisation_memberships OrganisationMember[]
  authored_posts           Post[]

  @@index([email])
  @@index([phone])
  @@index([id])
  @@map("users")
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  token_hash String    @unique
  user_uuid  String
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())

  user User @relation(fields: [user_uuid], references: [id], onDelete: Cascade)

  @@index([user_uuid])
  @@index([expires_at])
  @@map("password_reset_tokens")
}

// A Document always belongs to an Organisation.
model Document {
  id              String       @id @default(uuid())
  organisation_id String
  filename        String
  mimetype        String
  size            Int
  url             String
  path            String
  type            DocumentType @default(LOGO)
  created_at      DateTime     @default(now())

  organisation Organisation @relation(fields: [organisation_id], references: [id], onDelete: Cascade)

  post_attachments PostAttachment[]
  cover_of_posts   Post[]

  @@index([organisation_id])
  @@index([id])
  @@map("documents")
}

// A named workspace that owns its brand assets, connected social channels and
// posts. Every user has at least one (created for them automatically at
// registration). Created by one user (the Owner), who can add other members
// via OrganisationMember — never nested under another Organisation, and no
// cross-organisation sharing.
model Organisation {
  id                 String   @id @default(uuid())
  name               String
  slug               String   @unique
  created_by_user_id String
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  created_by User @relation(fields: [created_by_user_id], references: [id], onDelete: Cascade)

  members             OrganisationMember[]
  documents           Document[]
  posts               Post[]
  channel_connections SocialChannelConnection[]
  style_profiles      StyleProfile[]
  projects            Project[]

  @@index([created_by_user_id])
  @@index([slug])
  @@map("organisations")
}

// Links a User to an Organisation with one of 3 fixed roles (§6.3) — no
// invite/accept flow: members are created directly by an Owner/Admin.
// Removing this row revokes access without touching the User account.
model OrganisationMember {
  id              String           @id @default(uuid())
  organisation_id String
  user_id         String
  role            OrganisationRole
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt

  organisation Organisation @relation(fields: [organisation_id], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([organisation_id, user_id])
  @@index([organisation_id])
  @@index([user_id])
  @@map("organisation_members")
}

// A social account (Twitter/LinkedIn, etc.) connected for publishing.
// Always belongs to an Organisation.
model SocialChannelConnection {
  id                    String                        @id @default(uuid())
  organisation_id       String
  channel               SocialChannel
  status                SocialChannelConnectionStatus @default(CONNECTED)
  external_account_id   String
  external_account_name String?
  access_token          String
  refresh_token         String?
  token_expires_at      DateTime?
  created_at            DateTime                      @default(now())
  updated_at            DateTime                      @updatedAt

  organisation Organisation @relation(fields: [organisation_id], references: [id], onDelete: Cascade)

  post_channels PostChannel[]

  @@unique([channel, external_account_id])
  @@index([organisation_id])
  @@map("social_channel_connections")
}

// A reusable "Style DNA" fingerprint trained from a creator's own published
// posts (tone, structure, hooks, vocabulary, rhythm), used to steer AI
// drafting for a Project. Always belongs to an Organisation.
model StyleProfile {
  id               String    @id @default(uuid())
  organisation_id  String
  name             String
  platform         PostType
  source_url       String?
  posts_analyzed   Int       @default(0)
  tone_score       Int?
  structure_score  Int?
  hooks_score      Int?
  vocabulary_score Int?
  rhythm_score     Int?
  tone_description String?   @db.Text
  dominant_hook    String?
  vocabulary       String[]
  pillars          String[]
  last_analyzed_at DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  organisation Organisation @relation(fields: [organisation_id], references: [id], onDelete: Cascade)

  projects        ProjectStyleProfile[]
  generation_runs GenerationRun[]
  automations     Automation[]
  posts           Post[]

  @@index([organisation_id])
  @@map("style_profiles")
}

// Organizes AI generation and scheduling around a goal, audience and voice —
// a platform, content pillars, freeform ideas/instructions the AI follows,
// and one or more Style Profiles. Always belongs to an Organisation.
model Project {
  id              String   @id @default(uuid())
  organisation_id String
  title           String
  description     String?  @db.Text
  platform        PostType
  pillars         String[]
  ideas           String[]
  instructions    String[]
  is_archived     Boolean  @default(false)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisation_id], references: [id], onDelete: Cascade)

  style_profiles  ProjectStyleProfile[]
  posts           Post[]
  generation_runs GenerationRun[]
  automations     Automation[]

  @@index([organisation_id])
  @@map("projects")
}

model ProjectStyleProfile {
  id               String   @id @default(uuid())
  project_id       String
  style_profile_id String
  created_at       DateTime @default(now())

  project       Project      @relation(fields: [project_id], references: [id], onDelete: Cascade)
  style_profile StyleProfile @relation(fields: [style_profile_id], references: [id], onDelete: Cascade)

  @@unique([project_id, style_profile_id])
  @@index([project_id])
  @@index([style_profile_id])
  @@map("project_style_profiles")
}

// One AI generation batch within a Project: a set of Posts generated
// together from the project's context and a chosen Style Profile. Triggered
// either manually or by an Automation.
model GenerationRun {
  id               String   @id @default(uuid())
  project_id       String
  style_profile_id String?
  automation_id    String?
  label            String?
  posts_requested  Int?
  language         String   @default("en")
  created_at       DateTime @default(now())

  project       Project       @relation(fields: [project_id], references: [id], onDelete: Cascade)
  style_profile StyleProfile? @relation(fields: [style_profile_id], references: [id], onDelete: SetNull)
  automation    Automation?   @relation(fields: [automation_id], references: [id], onDelete: SetNull)

  posts Post[]

  @@index([project_id])
  @@index([style_profile_id])
  @@index([automation_id])
  @@map("generation_runs")
}

// A recurring, schedule-driven generation rule for a Project: runs on a
// frequency/time, generates `posts_per_run` drafts with a Style Profile, and
// drops them at `output_stage` (draft, pending review, or straight to
// publish).
model Automation {
  id               String                @id @default(uuid())
  project_id       String
  style_profile_id String?
  name             String
  is_active        Boolean               @default(true)
  frequency        AutomationFrequency   @default(WEEKLY)
  days_of_week     Int[]
  time_of_day      String
  timezone         String                @default("UTC")
  posts_per_run    Int                   @default(1)
  output_stage     AutomationOutputStage @default(DRAFT)
  last_run_at      DateTime?
  next_run_at      DateTime?
  created_at       DateTime              @default(now())
  updated_at       DateTime              @updatedAt

  project       Project       @relation(fields: [project_id], references: [id], onDelete: Cascade)
  style_profile StyleProfile? @relation(fields: [style_profile_id], references: [id], onDelete: SetNull)

  generation_runs GenerationRun[]

  @@index([project_id])
  @@index([style_profile_id])
  @@map("automations")
}

// A Post always has both an author (`user_id`) and the Organisation
// (`organisation_id`) it belongs to. `type` determines valid publish targets;
// blog-specific fields (title/slug/body/SEO) below are only populated for
// `BLOG` posts.
model Post {
  id                String     @id @default(uuid())
  user_id           String
  organisation_id   String
  project_id        String?
  style_profile_id  String?
  generation_run_id String?
  source_post_id    String?
  type              PostType
  status            PostStatus @default(DRAFT)
  hook              String?
  body              String?    @db.Text
  metadata          Json?

  // Blog-specific fields (populated only when type = BLOG).
  title             String?
  excerpt           String? @db.Text
  cover_document_id String?
  seo_title         String?
  seo_description   String?
  canonical_url     String?

  scheduled_at  DateTime?
  published_at  DateTime?
  failed_reason String?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  // The author is never deleted while they still have authored posts —
  // organisation-owned posts must not disappear just because the author's
  // account is removed later; reassign or delete posts first.
  user User @relation(fields: [user_id], references: [id], onDelete: Restrict)

  organisation   Organisation   @relation(fields: [organisation_id], references: [id], onDelete: Cascade)
  project        Project?       @relation(fields: [project_id], references: [id], onDelete: SetNull)
  style_profile  StyleProfile?  @relation(fields: [style_profile_id], references: [id], onDelete: SetNull)
  generation_run GenerationRun? @relation(fields: [generation_run_id], references: [id], onDelete: SetNull)
  cover_document Document?      @relation(fields: [cover_document_id], references: [id], onDelete: SetNull)

  // Repurposing lineage: a post generated from another post (e.g. a blog
  // repurposed into a Twitter thread) links back to its source.
  source_post      Post?  @relation("PostRepurpose", fields: [source_post_id], references: [id], onDelete: SetNull)
  repurposed_posts Post[] @relation("PostRepurpose")

  attachments PostAttachment[]
  channels    PostChannel[]

  @@index([user_id])
  @@index([organisation_id])
  @@index([project_id])
  @@index([style_profile_id])
  @@index([generation_run_id])
  @@index([source_post_id])
  @@index([cover_document_id])
  @@index([status])
  @@index([scheduled_at])
  @@map("posts")
}

// Ordered media (image/video/etc.) attached to a post, e.g. Twitter/LinkedIn
// media. Blog cover image is a separate 1:1 reference on
// Post.cover_document_id.
model PostAttachment {
  id          String   @id @default(uuid())
  post_id     String
  document_id String
  order       Int      @default(0)
  created_at  DateTime @default(now())

  post     Post     @relation(fields: [post_id], references: [id], onDelete: Cascade)
  document Document @relation(fields: [document_id], references: [id], onDelete: Cascade)

  @@unique([post_id, document_id])
  @@index([post_id])
  @@index([document_id])
  @@map("post_attachments")
}

// Join between a Post and one of its owner context's connected social
// channels, tracking per-channel publish state (a post can target several
// channel connections at once).
model PostChannel {
  id                    String            @id @default(uuid())
  post_id               String
  channel_connection_id String
  status                PostChannelStatus @default(PENDING)
  external_post_id      String?
  external_post_url     String?
  published_at          DateTime?
  failed_reason         String?
  created_at            DateTime          @default(now())
  updated_at            DateTime          @updatedAt

  post               Post                    @relation(fields: [post_id], references: [id], onDelete: Cascade)
  channel_connection SocialChannelConnection @relation(fields: [channel_connection_id], references: [id], onDelete: Cascade)

  @@unique([post_id, channel_connection_id])
  @@index([post_id])
  @@index([channel_connection_id])
  @@map("post_channels")
}
