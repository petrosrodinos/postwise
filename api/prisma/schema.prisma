// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AuthRole {
  USER
  ADMIN
  SUPER_ADMIN
  SUPPORT
}

enum DocumentType {
  LOGO
  BANNER
  IMAGE
  VIDEO
  AUDIO
  PDF
  DOCUMENT
  OTHER
}

// Also reused as the "platform" for StyleProfile and Project — all three
// concepts (a post, the profile it's trained from, the project it's planned
// under) share the same LinkedIn/X/Blog platform space.
enum PostType {
  TWITTER
  LINKEDIN
  BLOG
  INSTAGRAM
}

enum PostStatus {
  DRAFT
  REVIEW
  READY
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
}

enum IntegrationProvider {
  SANITY
  TWITTER
  LINKEDIN
}

enum IntegrationStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

enum PostIntegrationStatus {
  PENDING
  PUBLISHING
  PUBLISHED
  FAILED
}

enum OrganisationRole {
  OWNER
  ADMIN
  MEMBER
}

enum OrganisationMemberStatus {
  PENDING
  ACTIVE
}

enum AutomationFrequency {
  DAILY
  WEEKDAYS
  WEEKLY
}

enum AutomationOutputStage {
  DRAFT
  REVIEW
  PUBLISH
}

enum ActivityLogAction {
  USER_REGISTERED
  USER_LOGGED_IN
  USER_PROFILE_UPDATED
  PASSWORD_CHANGED
  PASSWORD_RESET_COMPLETED
  ORGANISATION_CREATED
  ORGANISATION_UPDATED
  ORGANISATION_DELETED
  MEMBER_ADDED
  MEMBER_INVITED
  MEMBER_INVITATION_RESENT
  MEMBER_INVITATION_ACCEPTED
  MEMBER_ROLE_UPDATED
  MEMBER_REMOVED
  DOCUMENT_UPLOADED
  DOCUMENT_UPDATED
  DOCUMENT_DELETED
  STYLE_PROFILE_CREATED
  STYLE_PROFILE_UPDATED
  STYLE_PROFILE_DELETED
  STYLE_PROFILE_ANALYZED
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_DELETED
  PROJECT_STYLE_PROFILE_ATTACHED
  PROJECT_STYLE_PROFILE_DETACHED
  PROJECT_RSS_FEED_ATTACHED
  PROJECT_RSS_FEED_DETACHED
  RSS_FEED_CREATED
  RSS_FEED_UPDATED
  RSS_FEED_DELETED
  RSS_FEED_ITEMS_FETCHED
  AUTOMATION_CREATED
  AUTOMATION_UPDATED
  AUTOMATION_DELETED
  AUTOMATION_RAN
  GENERATION_RUN_CREATED
  POST_CREATED
  POST_UPDATED
  POST_DELETED
  POST_SCHEDULED
  POST_PUBLISHED
  POST_PUBLISH_FAILED
  POST_REPURPOSED
  POST_ATTACHMENT_ADDED
  POST_ATTACHMENT_REMOVED
  INTEGRATION_CONNECTED
  INTEGRATION_UPDATED
  INTEGRATION_REMOVED
}

enum ActivityLogEntityType {
  USER
  ORGANISATION
  ORGANISATION_MEMBER
  DOCUMENT
  STYLE_PROFILE
  PROJECT
  RSS_FEED
  AUTOMATION
  GENERATION_RUN
  POST
  INTEGRATION
}

enum AiUsageType {
  TEXT
  IMAGE
}

enum AiUsageFeature {
  GENERATION_MULTI_CHANNEL_DRAFT
  GENERATION_RSS_DRAFT
  GENERATION_COVER_IMAGE
  POST_REVISE
  POST_REPURPOSE
  TOOLS_REVISE
  TOOLS_REPURPOSE
  TOOLS_TITLE_VARIATIONS
  TOOLS_META_TAGS
  TOOLS_IMAGE
  STYLE_PROFILE_ANALYZE
  PROJECT_GENERATE_DETAILS
  INTERNAL_PASSTHROUGH
}

model User {
  id       String  @id @default(uuid())
  name     String
  email    String  @unique
  phone    String? @unique
  password String

  role       AuthRole
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  password_reset_tokens    PasswordResetToken[]
  organisations_created    Organisation[]
  organisation_memberships OrganisationMember[]
  authored_posts           Post[]
  activity_logs            ActivityLog[]
  ai_usage_events          AiUsageEvent[]

  @@index([email])
  @@index([phone])
  @@index([id])
  @@map("users")
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  token_hash String    @unique
  user_uuid  String
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())

  user User @relation(fields: [user_uuid], references: [id], onDelete: Cascade)

  @@index([user_uuid])
  @@index([expires_at])
  @@map("password_reset_tokens")
}

// A Document always belongs to an Organisation.
model Document {
  id              String       @id @default(uuid())
  organisation_id String
  filename        String
  mimetype        String
  size            Int
  url             String
  path            String
  type            DocumentType @default(LOGO)
  created_at      DateTime     @default(now())

  organisation Organisation @relation(fields: [organisation_id], references: [id], onDelete: Cascade)

  post_attachments PostAttachment[]
  cover_of_posts   Post[]

  @@index([organisation_id])
  @@index([id])
  @@map("documents")
}

// A named workspace that owns its brand assets, connected social channels and
// posts. Every user has at least one (created for them automatically at
// registration). Created by one user (the Owner), who can add other members
// via OrganisationMember — never nested under another Organisation, and no
// cross-organisation sharing.
model Organisation {
  id                 String   @id @default(uuid())
  name               String
  slug               String   @unique
  created_by_user_id String
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  created_by User @relation(fields: [created_by_user_id], references: [id], onDelete: Cascade)

  members         OrganisationMember[]
  documents       Document[]
  posts           Post[]
  integrations    Integration[]
  style_profiles  StyleProfile[]
  projects        Project[]
  rss_feeds       RssFeed[]
  activity_logs   ActivityLog[]
  ai_usage_events AiUsageEvent[]

  @@index([created_by_user_id])
  @@index([slug])
  @@map("organisations")
}

// Links a User to an Organisation with one of 3 fixed roles (§6.3). Members
// can be added directly (Active immediately) or invited by email (Pending
// until they accept via OrganisationInviteToken and set a password).
// Removing this row revokes access without touching the User account.
model OrganisationMember {
  id              String                   @id @default(uuid())
  organisation_id String
  user_id         String
  role            OrganisationRole
  status          OrganisationMemberStatus @default(ACTIVE)
  created_at      DateTime                 @default(now())
  updated_at      DateTime                 @updatedAt

  organisation Organisation @relation(fields: [organisation_id], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  invite_tokens OrganisationInviteToken[]

  @@unique([organisation_id, user_id])
  @@index([organisation_id])
  @@index([user_id])
  @@map("organisation_members")
}

// An opaque, single-use token emailed to an invited member so they can set
// their own password. Mirrors PasswordResetToken's pattern (hash stored, not
// the raw token; DB-tracked expiry; used_at marks consumption) but is kept
// separate since a user's invite lifecycle is independent of their own
// unrelated password-reset flow.
model OrganisationInviteToken {
  id                     String    @id @default(uuid())
  token_hash             String    @unique
  organisation_member_id String
  invited_by_user_id     String
  expires_at             DateTime
  used_at                DateTime?
  created_at             DateTime  @default(now())

  organisation_member OrganisationMember @relation(fields: [organisation_member_id], references: [id], onDelete: Cascade)

  @@index([organisation_member_id])
  @@index([expires_at])
  @@map("organisation_invite_tokens")
}

// An external destination content can be published to — a social account
// (Twitter/LinkedIn) or a CMS (Sanity). Always belongs to an Organisation.
// Fields not used by a given provider stay null (e.g. Sanity rows never
// populate access_token_encrypted; social rows never populate
// external_project_id/external_dataset).
model Integration {
  id                      String              @id @default(uuid())
  organisation_id         String
  provider                IntegrationProvider
  name                    String
  status                  IntegrationStatus   @default(CONNECTED)
  // Social (Twitter/LinkedIn)
  external_account_id     String?
  external_account_name   String?
  access_token_encrypted  String?
  refresh_token_encrypted String?
  token_expires_at        DateTime?
  // Sanity
  external_project_id     String?
  external_dataset        String?
  document_type           String?
  api_token_encrypted     String?
  created_at              DateTime            @default(now())
  updated_at              DateTime            @updatedAt

  organisation      Organisation      @relation(fields: [organisation_id], references: [id], onDelete: Cascade)
  post_integrations PostIntegration[]

  @@unique([provider, external_account_id])
  @@index([organisation_id])
  @@map("integrations")
}

// A reusable "Style DNA" fingerprint trained from a creator's own published
// posts (tone, structure, hooks, vocabulary, rhythm), used to steer AI
// drafting for a Project. Always belongs to an Organisation.
model StyleProfile {
  id               String    @id @default(uuid())
  organisation_id  String
  name             String
  platform         PostType
  source_url       String?
  posts_analyzed   Int       @default(0)
  tone_score       Int?
  structure_score  Int?
  hooks_score      Int?
  vocabulary_score Int?
  rhythm_score     Int?
  tone_description String?   @db.Text
  dominant_hook    String?
  vocabulary       String[]
  pillars          String[]
  last_analyzed_at DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  organisation Organisation @relation(fields: [organisation_id], references: [id], onDelete: Cascade)

  projects        ProjectStyleProfile[]
  generation_runs GenerationRun[]
  automations     Automation[]
  posts           Post[]

  @@index([organisation_id])
  @@map("style_profiles")
}

// Organizes AI generation and scheduling around a goal, audience and voice —
// a platform, content pillars, freeform ideas/instructions the AI follows,
// and one or more Style Profiles. Always belongs to an Organisation.
model Project {
  id              String     @id @default(uuid())
  organisation_id String
  title           String
  description     String?    @db.Text
  // Denormalized primary channel, always equal to channels[0].
  platform        PostType
  // Target content channels this project generates for, e.g. [LINKEDIN, X,
  // BLOG] together — one AI batch fans an idea out across all of them.
  channels        PostType[]
  pillars         String[]
  ideas           String[]
  instructions    String[]
  ai_directions   String?    @db.Text
  // When true, generation (manual and automation) applies the same
  // "remove AI writing tells" instructions as the HUMANIZE revise preset.
  humanize_by_default Boolean @default(false)
  is_archived     Boolean    @default(false)
  created_at      DateTime   @default(now())
  updated_at      DateTime   @updatedAt

  organisation Organisation @relation(fields: [organisation_id], references: [id], onDelete: Cascade)

  style_profiles  ProjectStyleProfile[]
  rss_feeds       ProjectRssFeed[]
  posts           Post[]
  generation_runs GenerationRun[]
  automations     Automation[]

  @@index([organisation_id])
  @@map("projects")
}

// A reusable blog RSS source, organisation-scoped, attachable to many
// Projects (mirrors StyleProfile/ProjectStyleProfile). Only the feed's own
// title/summary/content fields are ever used — no full-article scraping.
model RssFeed {
  id               String    @id @default(uuid())
  organisation_id  String
  name             String
  url              String
  last_fetched_at  DateTime?
  last_fetch_error String?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  organisation Organisation @relation(fields: [organisation_id], references: [id], onDelete: Cascade)

  projects    ProjectRssFeed[]
  items       RssFeedItem[]
  automations Automation[]

  @@index([organisation_id])
  @@map("rss_feeds")
}

model ProjectRssFeed {
  id          String   @id @default(uuid())
  project_id  String
  rss_feed_id String
  created_at  DateTime @default(now())

  project  Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  rss_feed RssFeed @relation(fields: [rss_feed_id], references: [id], onDelete: Cascade)

  @@unique([project_id, rss_feed_id])
  @@index([project_id])
  @@index([rss_feed_id])
  @@map("project_rss_feeds")
}

// One fetched RSS entry, persisted so re-fetches dedupe by guid and
// "unused only" filtering can exclude items already turned into a Post.
model RssFeedItem {
  id           String    @id @default(uuid())
  rss_feed_id  String
  guid         String
  title        String
  link         String?
  summary      String?   @db.Text
  content      String?   @db.Text
  published_at DateTime?
  is_used      Boolean   @default(false)
  fetched_at   DateTime  @default(now())

  rss_feed RssFeed @relation(fields: [rss_feed_id], references: [id], onDelete: Cascade)
  posts    Post[]

  @@unique([rss_feed_id, guid])
  @@index([rss_feed_id])
  @@index([rss_feed_id, is_used])
  @@map("rss_feed_items")
}

model ProjectStyleProfile {
  id               String   @id @default(uuid())
  project_id       String
  style_profile_id String
  created_at       DateTime @default(now())

  project       Project      @relation(fields: [project_id], references: [id], onDelete: Cascade)
  style_profile StyleProfile @relation(fields: [style_profile_id], references: [id], onDelete: Cascade)

  @@unique([project_id, style_profile_id])
  @@index([project_id])
  @@index([style_profile_id])
  @@map("project_style_profiles")
}

// One AI generation batch within a Project: a set of Posts generated
// together from the project's context and a chosen Style Profile. Triggered
// either manually or by an Automation.
model GenerationRun {
  id               String   @id @default(uuid())
  project_id       String
  style_profile_id String?
  automation_id    String?
  label            String?
  posts_requested  Int?
  language         String   @default("en")
  created_at       DateTime @default(now())

  project       Project       @relation(fields: [project_id], references: [id], onDelete: Cascade)
  style_profile StyleProfile? @relation(fields: [style_profile_id], references: [id], onDelete: SetNull)
  automation    Automation?   @relation(fields: [automation_id], references: [id], onDelete: SetNull)

  posts        Post[]
  items        GenerationItem[]
  usage_events AiUsageEvent[]

  @@index([project_id])
  @@index([style_profile_id])
  @@index([automation_id])
  @@map("generation_runs")
}

// One generated "idea" within a GenerationRun. For BLOG projects an item has
// exactly one child Post; for social projects it has one child Post per
// project.channels entry (e.g. one LinkedIn version + one Twitter version of
// the same idea).
model GenerationItem {
  id                String   @id @default(uuid())
  generation_run_id String
  order             Int
  topic             String?  @db.Text
  created_at        DateTime @default(now())

  generation_run GenerationRun @relation(fields: [generation_run_id], references: [id], onDelete: Cascade)
  posts          Post[]

  @@index([generation_run_id])
  @@map("generation_items")
}

// A recurring, schedule-driven generation rule for a Project: runs on a
// frequency/time, generates `posts_per_run` drafts with a Style Profile, and
// drops them at `output_stage` (draft, pending review, or straight to
// publish).
model Automation {
  id               String                @id @default(uuid())
  project_id       String
  style_profile_id String?
  rss_feed_id      String?
  name             String
  is_active        Boolean               @default(true)
  frequency        AutomationFrequency   @default(WEEKLY)
  days_of_week     Int[]
  time_of_day      String
  timezone         String                @default("UTC")
  posts_per_run    Int                   @default(1)
  output_stage     AutomationOutputStage @default(DRAFT)
  generate_images  Boolean               @default(false)
  image_count      Int                   @default(1)
  last_run_at      DateTime?
  next_run_at      DateTime?
  created_at       DateTime              @default(now())
  updated_at       DateTime              @updatedAt

  project       Project       @relation(fields: [project_id], references: [id], onDelete: Cascade)
  style_profile StyleProfile? @relation(fields: [style_profile_id], references: [id], onDelete: SetNull)
  rss_feed      RssFeed?      @relation(fields: [rss_feed_id], references: [id], onDelete: SetNull)

  generation_runs GenerationRun[]
  posts           Post[]

  @@index([project_id])
  @@index([style_profile_id])
  @@index([rss_feed_id])
  @@map("automations")
}

// A Post always has both an author (`user_id`) and the Organisation
// (`organisation_id`) it belongs to. `type` determines valid publish targets;
// blog-specific fields (title/slug/body/SEO) below are only populated for
// `BLOG` posts.
model Post {
  id                 String     @id @default(uuid())
  user_id            String
  organisation_id    String
  project_id         String?
  style_profile_id   String?
  generation_run_id  String?
  generation_item_id String?
  source_post_id     String?
  rss_feed_item_id   String?
  automation_id      String?
  type               PostType
  status             PostStatus @default(DRAFT)
  hook               String?
  body               String?    @db.Text
  metadata           Json?

  // Blog-specific fields (populated only when type = BLOG).
  title             String?
  excerpt           String? @db.Text
  cover_document_id String?
  seo_title         String?
  seo_description   String?
  canonical_url     String?

  scheduled_at  DateTime?
  published_at  DateTime?
  failed_reason String?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  // The author is never deleted while they still have authored posts —
  // organisation-owned posts must not disappear just because the author's
  // account is removed later; reassign or delete posts first.
  user User @relation(fields: [user_id], references: [id], onDelete: Restrict)

  organisation    Organisation    @relation(fields: [organisation_id], references: [id], onDelete: Cascade)
  project         Project?        @relation(fields: [project_id], references: [id], onDelete: SetNull)
  style_profile   StyleProfile?   @relation(fields: [style_profile_id], references: [id], onDelete: SetNull)
  generation_run  GenerationRun?  @relation(fields: [generation_run_id], references: [id], onDelete: SetNull)
  generation_item GenerationItem? @relation(fields: [generation_item_id], references: [id], onDelete: SetNull)
  cover_document  Document?       @relation(fields: [cover_document_id], references: [id], onDelete: SetNull)
  rss_feed_item   RssFeedItem?    @relation(fields: [rss_feed_item_id], references: [id], onDelete: SetNull)
  automation      Automation?     @relation(fields: [automation_id], references: [id], onDelete: SetNull)

  // Repurposing lineage: a post generated from another post (e.g. a blog
  // repurposed into a Twitter thread) links back to its source.
  source_post      Post?  @relation("PostRepurpose", fields: [source_post_id], references: [id], onDelete: SetNull)
  repurposed_posts Post[] @relation("PostRepurpose")

  attachments  PostAttachment[]
  integrations PostIntegration[]
  usage_events AiUsageEvent[]

  @@index([user_id])
  @@index([organisation_id])
  @@index([project_id])
  @@index([style_profile_id])
  @@index([generation_run_id])
  @@index([generation_item_id])
  @@index([source_post_id])
  @@index([cover_document_id])
  @@index([rss_feed_item_id])
  @@index([automation_id])
  @@index([status])
  @@index([scheduled_at])
  @@map("posts")
}

// Ordered media (image/video/etc.) attached to a post, e.g. Twitter/LinkedIn
// media. Blog cover image is a separate 1:1 reference on
// Post.cover_document_id.
model PostAttachment {
  id          String   @id @default(uuid())
  post_id     String
  document_id String
  order       Int      @default(0)
  created_at  DateTime @default(now())

  post     Post     @relation(fields: [post_id], references: [id], onDelete: Cascade)
  document Document @relation(fields: [document_id], references: [id], onDelete: Cascade)

  @@unique([post_id, document_id])
  @@index([post_id])
  @@index([document_id])
  @@map("post_attachments")
}

// Join between a Post and one of its owner context's connected integrations
// (a social account or a CMS), tracking per-integration publish state — a
// post can target several integrations at once (e.g. two LinkedIn accounts).
model PostIntegration {
  id             String                @id @default(uuid())
  post_id        String
  integration_id String
  status         PostIntegrationStatus @default(PENDING)
  external_id    String?
  external_url   String?
  published_at   DateTime?
  failed_reason  String?
  created_at     DateTime              @default(now())
  updated_at     DateTime              @updatedAt

  post        Post        @relation(fields: [post_id], references: [id], onDelete: Cascade)
  integration Integration @relation(fields: [integration_id], references: [id], onDelete: Cascade)

  @@unique([post_id, integration_id])
  @@index([post_id])
  @@index([integration_id])
  @@map("post_integrations")
}

// A single recorded action, written fire-and-forget from the service that
// performed it. `user_id` is null for system/cron-triggered events
// (scheduled auto-publish, automation runs) so the UI can show "System".
// `organisation_id` is null for account-level events not scoped to an
// organisation (login, password change).
model ActivityLog {
  id              String                 @id @default(uuid())
  organisation_id String?
  user_id         String?
  action          ActivityLogAction
  entity_type     ActivityLogEntityType?
  entity_id       String?
  description     String
  metadata        Json?
  created_at      DateTime               @default(now())

  organisation Organisation? @relation(fields: [organisation_id], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([organisation_id, created_at])
  @@index([user_id])
  @@index([action])
  @@map("activity_logs")
}

// One row per successful AI SDK call (text or image generation), written
// fire-and-forget by AiUsageService right after the call returns.
// organisation_id/user_id are nullable and use SetNull (not Cascade, unlike
// most org-scoped tables) — this is a cost ledger, and deleting an org, user,
// generation run or post must never silently destroy historical cost
// records. organisation_id is null only for the org-less internal admin
// passthrough; user_id is null for automation/cron-triggered runs.
model AiUsageEvent {
  id              String         @id @default(uuid())
  organisation_id String?
  user_id         String?
  type            AiUsageType
  feature         AiUsageFeature
  provider        String
  model           String

  input_tokens  Int?
  output_tokens Int?
  total_tokens  Int?
  image_count   Int?

  input_cost  Decimal @default(0) @db.Decimal(14, 8)
  output_cost Decimal @default(0) @db.Decimal(14, 8)
  total_cost  Decimal @default(0) @db.Decimal(14, 8)

  generation_run_id String?
  post_id           String?

  metadata   Json?
  created_at DateTime @default(now())

  organisation   Organisation?  @relation(fields: [organisation_id], references: [id], onDelete: SetNull)
  user           User?          @relation(fields: [user_id], references: [id], onDelete: SetNull)
  generation_run GenerationRun? @relation(fields: [generation_run_id], references: [id], onDelete: SetNull)
  post           Post?          @relation(fields: [post_id], references: [id], onDelete: SetNull)

  @@index([organisation_id, created_at])
  @@index([organisation_id, user_id])
  @@index([organisation_id, feature])
  @@index([organisation_id, type])
  @@index([generation_run_id])
  @@map("ai_usage_events")
}
